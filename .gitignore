# ============================================================
# .gitignore — Logistics Cargo Damage Detection System
# ============================================================

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# ── Virtual Environments ────────────────────────────────────
.venv/
venv/
ENV/

# ── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.code-workspace

# ── OS Files ────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Dataset (too large for Git — download from Roboflow) ───
datasets/train/
datasets/valid/
datasets/old_dataset/
datasets/_merged/
datasets/*.cache
**/*.cache

# ── Training Runs ───────────────────────────────────────────
# Keep best.pt and result plots, exclude heavy checkpoints
runs/detect/train/
runs/detect/train2/
runs/detect/train3/
runs/detect/train32/
runs/detect/val/
runs/detect/val2/

# Inside train_merged: exclude epoch checkpoints (~24MB each)
runs/detect/train_merged/weights/epoch*.pt
runs/detect/train_merged/weights/last.pt

# ── Output Videos (regenerated by inference) ────────────────
output/

# ── Data / Videos (user-provided) ──────────────────────────
data/videos/

# ── Misc ────────────────────────────────────────────────────
*.log
_check_best.py
